{
  "genre": "Clean",
  "presets": [
    {
      "name": "Sunup Studio",
      "description": "A pristine, hi-fi studio clean with gentle compression and a short hall. Stomp 2 for a clean boost when the part needs to speak up.",
      "amp": {
        "type": "amp.head",
        "knobs": {
          "voice": "American Clean",
          "gain": 0.25,
          "bass": 0.45,
          "mid": 0.5,
          "treble": 0.6,
          "presence": 0.45,
          "master": 0.6
        }
      },
      "cab": {
        "type": "cab.speaker",
        "knobs": {
          "cabinet": "2x12 Closed",
          "mic": 0.35,
          "lowcut": 80,
          "highcut": 10000,
          "room": 0.1,
          "level": 5.2
        }
      },
      "board": [
        {
          "type": "dyn.compressor",
          "spot": 0,
          "on": true,
          "knobs": {
            "sustain": 0.35,
            "attack": 12,
            "blend": 0.7
          }
        },
        {
          "type": "dyn.boost",
          "spot": 1,
          "on": false,
          "knobs": {
            "boost": 3.5,
            "tilt": 0.1,
            "voice": "Flat"

    {
      "name": "Saffron Smoke",
      "description": "Woolly fuzz into a deep, slow phaser and drippy springs for classic late-sixties psych leads.",
      "amp": {
        "type": "amp.stadium",
        "knobs": {
          "input": "Bright",
          "volume": 0.45,
          "bass": 0.45,
          "mid": 0.6,
          "treble": 0.55,
          "sag": 0.5
        }
      },
      "cab": {
        "type": "cab.hangar",
        "knobs": {
          "cabinet": "Warm 4x12",
          "highcut": 7500,
          "level": -1.1
        }
      },
      "board": [
        {
          "type": "drive.vintage",
          "spot": 0,
          "on": true,
          "knobs": {
            "fuzz": 0.7,
            "volume": 0
          }
        },
        {
          "type": "mod.phaser",
          "spot": 3,
          "on": true,
          "knobs": {
            "rate": 0.35,
            "depth": 0.8,

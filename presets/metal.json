{
  "genre": "Hard Rock & Metal",
  "presets": [
    {
      "name": "Iron Bastion",
      "description": "Modern brick-wall rhythm: a gate and a tight boost slam the high-gain amp, with the cab's fizz trimmed off. Stomp 9 for a lead echo.",
      "amp": {
        "type": "amp.fortress",
        "knobs": {
          "channel": "Lead",
          "tight": "Tight",
          "gain": 0.6,
          "bass": 0.5,
          "lowmid": 1,
          "highmid": 2,
          "treble": 0.5,
          "master": 0.5
        }
      },
      "cab": {
        "type": "cab.hangar",
        "knobs": {
          "cabinet": "Warm 4x12",
          "mic": "Dynamic",
          "position": 0.3,
          "distance": 0.15,
          "lowcut": 80,
          "highcut": 6500,
          "level": 0.7
        }
      },
      "board": [
        {
          "type": "dyn.gate",
          "spot": 0,
          "on": true,
          "knobs": {
            "threshold": -52,
            "release": 60
          }
        },
        {
          "type": "drive.overdrive",
          "spot": 1,
          "on": true,
          "knobs": {
            "drive": 0.05,
            "level": 6,
            "tone": 0.6
          }
        },
        {
          "type": "delay.digital",

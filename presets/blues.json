    {
      "name": "Delta Porch",
      "description": "Small combo right on the edge of breakup: clean when you play soft, hairy when you dig in. Stomp the boost for a solo lift.",
      "amp": {
        "type": "amp.roadhouse",
        "knobs": {
          "channel": "Bright",
          "volume": 0.55,
          "tone": 0.5,
          "output": 0
        }
      },
      "cab": {
        "type": "cab.hangar",
        "knobs": {
          "cabinet": "2x12 Open",
          "mic": "Ribbon",
          "position": 0.35,
          "distance": 0.3,
          "level": -0.7
        }
      },
      "board": [
        {
          "type": "dyn.boost",
          "spot": 0,
          "on": false,
          "knobs": {
            "boost": 4,
            "tilt": 0.1,
            "voice": "Fat"
          }
        },
        {
          "type": "reverb.spring",
          "spot": 9,
          "on": true,
          "knobs": {
            "decay": 1600,
            "mix": 0.18,
            "drip": 0.4
          }
        }
      ]
    },

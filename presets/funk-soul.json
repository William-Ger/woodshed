          "knobs": {
            "b100": -6,
            "b200": -3,
            "b400": -2,
            "b800": 1,
            "b1k6": 3,
            "b3k2": 3,
            "b6k4": 2
          }
        },
        {
          "type": "dyn.boost",
          "spot": 3,
          "on": false,
          "knobs": {
            "boost": 2.5,
            "tilt": 0.2,
            "voice": "Tight"
          }
        },
        {
          "type": "mod.phaser",
          "spot": 4,
          "on": false,
          "knobs": {
            "rate": 0.5,
            "depth": 0.6,
            "center": 900,
            "stages": "4",
            "mix": 0.5

{
  "genre": "Funk & Soul",
  "presets": [
    {
      "name": "Gold Lamé Strut",
      "description": "Bright, glassy disco-funk rhythm: squeezed and snappy for muted sixteenth chops, thin lows, a hint of chorus shimmer and a short plate. Stomp 4 to lift single-note fills, 5 for a phaser groove.",
      "amp": {
        "type": "amp.head",
        "knobs": {
          "voice": "American Clean",
          "gain": 0.2,
          "bass": 0.35,
          "mid": 0.5,
          "treble": 0.72,
          "presence": 0.6,
          "master": 0.6
        }
      },
      "cab": {
        "type": "cab.sidecar",
        "knobs": {
          "cabinet": "2x12 Open",
          "mica": "Dynamic",
          "micb": "Condenser",
          "blend": 0.4,
          "lowcut": 150,
          "highcut": 12000,
          "level": 6.0
        }
      },
      "board": [
        {
          "type": "dyn.compressor",
          "spot": 0,
          "on": true,
          "knobs": {
            "sustain": 0.6,
            "attack": 2,
            "blend": 0.85,
            "level": 6.5
          }
        },
        {

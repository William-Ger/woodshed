    {
      "name": "Postcard Chime",
      "description": "Bright, jangly class-A chime for open chords and arpeggios, with a touch of compression and spring.",
      "amp": {
        "type": "amp.bandstand",
        "knobs": {
          "channel": "Brilliant",
          "volume": 0.4,
          "treble": 0.6,
          "bass": 0.45,
          "cut": 0.35,
          "master": 0.5
        }
      },
      "cab": {
        "type": "cab.speaker",
        "knobs": {
          "cabinet": "2x12 Closed",
          "mic": 0.25,
          "highcut": 11000,
          "room": 0.15,
          "level": 2.5
        }
      },
      "board": [
        {
          "type": "dyn.compressor",
          "spot": 0,
          "on": true,
          "knobs": {
            "sustain": 0.5,

{
  "genre": "Cinematic",
  "presets": [
    {
      "name": "High Noon Canyon",
      "description": "Twangy compressed clean with a dry tape echo and a canyon-sized reverb for wide-open western themes. Stomp 3 for a slow tremolo.",
      "amp": {
        "type": "amp.bandstand",
        "knobs": {
          "channel": "Normal",
          "volume": 0.4,
          "treble": 0.6,
          "bass": 0.45,
          "cut": 0.3
        }
      },
      "cab": {
        "type": "cab.hangar",
        "knobs": {
          "cabinet": "2x12 Open",
          "mic": "Ribbon",
          "level": 4.9
        }
      },
      "board": [
        {
          "type": "dyn.compressor",
          "spot": 0,
          "on": true,
          "knobs": {
            "sustain": 0.5,
            "attack": 12
          }
        },
        {
          "type": "drive.treble",
          "spot": 1,
          "on": true,
          "knobs": {
            "boost": 0.3,
            "range": "Treble"
          }
        },
        {
          "type": "mod.tremolo",
          "spot": 2,
          "on": false,
          "knobs": {
            "rate": 3.5,
            "depth": 0.55,
            "wave": "Bias"
          }
        },
        {
          "type": "delay.tape",
          "spot": 5,
          "on": true,
          "knobs": {
            "time": 380,
            "repeats": 0.3,
            "mix": 0.25,
            "wow": 0.2
          }
        },
        {
          "type": "reverb.hall",
          "spot": 7,
          "on": true,
          "knobs": {
            "decay": 6000,
            "size": 0.85,
            "predelay": 40,
            "mix": 0.4
          }
        }
      ]
    },

{
  "genre": "Ambient & Shoegaze",
  "presets": [
    {
      "name": "Northern Vault",
      "description": "Glassy clean pad with an octave-rising shimmer tail that hangs in the air. Stomp the chorus for extra width.",
      "amp": {
        "type": "amp.head",
        "knobs": {
          "voice": "American Clean",
          "gain": 0.3,
          "bass": 0.45,
          "treble": 0.55,
          "master": 0.55
        }
      },
      "cab": {
        "type": "cab.speaker",
        "knobs": {
          "cabinet": "2x12 Closed",
          "highcut": 9000,
          "level": 1.7
        }
      },
      "board": [
        {
          "type": "dyn.compressor",
          "spot": 0,
          "on": true,
          "knobs": {
            "sustain": 0.45,
            "attack": 15,
            "level": 0
          }
        },
        {
          "type": "mod.chorus",
          "spot": 4,
          "on": false,
          "knobs": {
            "rate": 0.3,
            "depth": 0.35,
            "mix": 0.35
          }
        },
        {
          "type": "reverb.shimmer",
          "spot": 8,
          "on": true,
          "knobs": {
            "decay": 9000,
            "shimmer": 0.5,
            "interval": "Octave",
            "mix": 0.4,
            "predelay": 60
          }
        }
      ]
    },
